# --- Database ---
# Local file DB (default):
DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3

# To use PostgreSQL in development, switch to:
# DB_ENGINE=postgresql
# DB_NAME=loonkoo
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432
# If the DB lives on cPanel and your laptop connects remotely:
# DB_HOST=loonko-api2.ethioace.com
# (cPanel must allow remote Postgres / your IP)
